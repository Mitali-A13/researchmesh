MISTRAL_API_KEY=
TAVILY_API_KEY=
SECRET_KEY=            # long random string, e.g. run: openssl rand -hex 32
DATABASE_URL=sqlite:///./thinkmesh.db
VERIFY_IN_LOOP=false

JOB_WORKERS=2                 # reports that can run at the same time
MAX_ACTIVE_JOBS_PER_USER=1    # a user can have this many reports running
DAILY_REPORT_LIMIT=10         # reports per user per day (failed ones don't count)